option_settings:
  aws:elasticbeanstalk:command:
    # pyswisseph builds from C source (no wheel). Give the build room.
    Timeout: 1800
  aws:elasticbeanstalk:application:environment:
    # Pre-generated report PDFs live OUTSIDE the deploy bundle so the cache
    # survives eb deploys. Without this, pdfgen.PDF_DIR defaults to
    # ./data/pdfs inside /var/app/current, which EB replaces on every deploy —
    # every previously sold report then re-renders on first click (slow on the
    # 1 GB box; the download button falls back to the print dialog meanwhile).
    PDF_DIR: /var/app/pdfs

commands:
  01_create_swap:
    # t4g.micro has only 1 GB RAM; compiling native extensions (pyswisseph)
    # OOMs and thrashes. Add 2 GB swap BEFORE dependency install so the build
    # completes quickly instead of hanging. Runs early, as root, and is a no-op
    # if the swapfile already exists.
    command: "bash -c 'if [ ! -f /var/swapfile ]; then dd if=/dev/zero of=/var/swapfile bs=1M count=2048 && chmod 600 /var/swapfile && mkswap /var/swapfile && swapon /var/swapfile; fi'"
    ignoreErrors: true
  02_pdf_cache_dir:
    # Persistent PDF cache dir (see PDF_DIR above). webapp is the user the
    # application runs as on AL2023 EB. Idempotent; best-effort like the rest.
    command: "mkdir -p /var/app/pdfs && chown webapp:webapp /var/app/pdfs || true"
    ignoreErrors: true
