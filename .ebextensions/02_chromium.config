# Headless Chromium for browser-quality PDFs (pdfgen.py) — ARM-aware.
#
# The instance is Graviton (aarch64) Amazon Linux 2023: there is NO dnf
# `chromium` package for it (the first version of this config silently
# installed nothing → "[pdf] no Chrome binary found" in the logs).
# Playwright publishes prebuilt Linux arm64 builds of chrome-headless-shell,
# so we install that instead. Browsers land in /opt/pw-browsers and pdfgen
# discovers the binary by glob (PLAYWRIGHT_BROWSERS_PATH).
#
# Everything is best-effort (ignoreErrors): if any step fails the app still
# deploys — the Download button falls back to the print dialog and WhatsApp
# falls back to the text template (owner-approved UX).
#
# Post-deploy verification:
#   ls /opt/pw-browsers/            -> chromium_headless_shell-*/
#   eb logs | grep "\[pdf\]"        -> "pregenerate <rid> -> ok"
commands:
  01_shared_libs:
    # Runtime libraries chrome-headless-shell links against (AL2023 names).
    command: "dnf -y install nss nspr atk at-spi2-atk cups-libs libdrm libXcomposite libXdamage libXrandr libXtst libxkbcommon pango cairo alsa-lib mesa-libgbm libX11 libXext expat glib2 || true"
    ignoreErrors: true
  02_playwright_shell:
    # Idempotent: playwright skips the download when the build is present.
    command: "pip3 install --quiet 'playwright>=1.47' && PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers python3 -m playwright install chromium-headless-shell || true"
    ignoreErrors: true
  03_readable:
    command: "chmod -R a+rx /opt/pw-browsers || true"
    ignoreErrors: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    PLAYWRIGHT_BROWSERS_PATH: /opt/pw-browsers
