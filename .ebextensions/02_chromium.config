# Headless Chromium for browser-quality PDF generation (pdfgen.py).
# The report PDF is rendered by Chrome's --print-to-pdf (same engine as the
# browser's print dialog) so the download matches the on-screen design.
#
# NOTE: verify on the instance after deploy:  chromium-headless --version
#       (or set CHROME_BIN to whatever binary the package provides).
# If the package is unavailable on this platform the app still works — the
# download button falls back to the print dialog + toaster by design.
commands:
  01_install_chromium:
    # Amazon Linux 2023: chromium lives in the standard repos on most platform
    # versions; ignoreErrors keeps deploys green if it's missing (fallback UX).
    command: "dnf -y install chromium || dnf -y install chromium-headless || true"
    ignoreErrors: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    CHROME_BIN: /usr/bin/chromium-browser
