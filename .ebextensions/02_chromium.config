# Headless Chromium for browser-quality PDFs (pdfgen.py) — ARM-aware, take 3.
#
# History of this file (so the next person doesn't repeat it):
#   v1: `dnf install chromium` — no such package on Graviton/aarch64 AL2023.
#   v2: `pip3 install playwright && python3 -m playwright ...` — FAILED:
#       `pip3` on the EB box resolves to a DIFFERENT interpreter than
#       /usr/bin/python3, so playwright landed in one Python and the install
#       step ran under another ("No module named playwright"), silently
#       swallowed by `|| true` (visible in cfn-init-cmd.log).
#   v3 (this): pin ONE interpreter — /usr/bin/python3 — for both the pip
#       install and the browser download. python3-pip via dnf first.
#
# Browsers land in /opt/pw-browsers; pdfgen discovers the binary by glob.
# Best-effort: any failure degrades to the print-dialog fallback UX.
#
# Post-deploy verification:
#   ls /opt/pw-browsers/                      -> chromium_headless_shell-*/
#   grep "\[pdf\]" logs                       -> "pregenerate <rid> -> ok"
#   cfn-init-cmd.log                          -> output of each step below
commands:
  01_shared_libs:
    command: "dnf -y install nss nspr atk at-spi2-atk cups-libs libdrm libXcomposite libXdamage libXrandr libXtst libxkbcommon pango cairo alsa-lib mesa-libgbm libX11 libXext expat glib2 || true"
    ignoreErrors: true
  01b_fonts:
    # Emoji + Hindi + text fonts for PDF rendering: without these, headless
    # Chrome draws BLANKS where emojis (and Devanagari like ॐ) appear in the
    # report. fc-cache refreshes fontconfig so Chrome sees them immediately.
    command: "dnf -y install google-noto-color-emoji-fonts google-noto-sans-fonts google-noto-serif-fonts google-noto-sans-devanagari-fonts fontconfig && fc-cache -f || true"
    ignoreErrors: true
  02_pip:
    command: "dnf -y install python3-pip || true"
    ignoreErrors: true
  03_playwright:
    command: "/usr/bin/python3 -m pip install --quiet 'playwright>=1.45' 2>&1 | tail -2"
    ignoreErrors: true
  04_browser:
    # Idempotent: playwright skips the download when the build is present.
    command: "PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers /usr/bin/python3 -m playwright install chromium-headless-shell 2>&1 | tail -3"
    ignoreErrors: true
  05_readable:
    command: "chmod -R a+rx /opt/pw-browsers || true"
    ignoreErrors: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    PLAYWRIGHT_BROWSERS_PATH: /opt/pw-browsers
