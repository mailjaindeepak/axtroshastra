# Axtroshastra — environment variables.
# Copy to `.env` for local dev, or set these in your host dashboard (Railway/Render).
# NEVER commit the real .env — only this example belongs in git.

# ---- Razorpay (payments) ----
# From Razorpay Dashboard. Use rzp_live_* keys in production, rzp_test_* for testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Settings > Webhooks. Used to HMAC-verify payment.captured events.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Public site URL (used in WhatsApp links, sitemap, robots.txt) ----
PUBLIC_BASE_URL=https://www.axtroshastra.com

# ---- Storage ----
# SQLite path. Mount a persistent volume at this directory in production.
DB_PATH=./data/reports.db

# ---- Admin key (gates /api/stats and /api/make_pass) ----
STATS_KEY=change-me-to-a-long-random-string

# ---- Twilio WhatsApp delivery (optional; no-op until all set) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# ---- OTP login (Twilio Verify) ----
# Create a Verify Service in the Twilio console (Verify > Services) and paste its
# SID here (starts with VA...). When set, login OTPs are sent + checked by Twilio
# Verify, which owns the message templates (the launch-today path for India).
# When UNSET, login falls back to a dev code logged to the console (local only).
TWILIO_VERIFY_SERVICE_SID=
# Delivery channel for the login OTP: whatsapp (default, launchable today) | sms
# (needs DLT template approval first) | call | email.
TWILIO_VERIFY_CHANNEL=whatsapp

# ---- LLM narrative layer (optional; OFF by default -> deterministic banks) ----
# When "1", paid reports get their descriptive PROSE rewritten by an LLM at
# payment time (facts/scores stay engine-computed; prose is cached on the report).
# Uses stdlib HTTP — no SDK, nothing to add to the offline wheelhouse.
NARRATIVE_ENABLED=
NARRATIVE_PROVIDER=claude          # claude | openai  (swap providers with one var)
NARRATIVE_MODEL=                   # optional override; else claude-sonnet-5 / gpt-4o-mini
NARRATIVE_LANG=hinglish            # hinglish | english
NARRATIVE_TONE=                    # optional extra voice line for the system prompt
NARRATIVE_TEMPERATURE=0.7
NARRATIVE_MAX_TOKENS=1500
NARRATIVE_TIMEOUT=30
ANTHROPIC_API_KEY=                 # for NARRATIVE_PROVIDER=claude
OPENAI_API_KEY=                    # for NARRATIVE_PROVIDER=openai

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Local testing only. NEVER set in production. ----
# "1" enables POST /api/_demo_pay/{rid} to bypass real payment.
DEMO_MODE=

# ---- Geocoding (#1) ----
GEOCODER=nominatim                 # nominatim | google | off
GOOGLE_GEOCODING_KEY=
GEOCODER_USER_AGENT=axtroshastra/1.0 (contact: axtroshastra@gmail.com)

# ---- Rate limiting & bot defense (#4) ----
RATE_LIMIT_ENABLED=1               # 1 | 0
CAPTCHA_PROVIDER=                  # ""(off) | hcaptcha | recaptcha
CAPTCHA_SECRET=

# ---- Email delivery (#7) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# ---- Browser-quality PDF (pdfgen.py) ----
# Path to Chrome/Chromium for --print-to-pdf. Unset => common paths probed;
# none found => download button falls back to the print dialog + toaster.
CHROME_BIN=
# Cache dir for pre-generated report PDFs (default ./data/pdfs)
PDF_DIR=
# Approved TEXT WhatsApp template (fallback when the PDF isn't ready) — the
# original report-link template SID. Guarantees delivery if Chrome/PDF fails.
TWILIO_CONTENT_SID_TEXT=
