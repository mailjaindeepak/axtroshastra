# Axtroshastra — environment variables.
# Copy to `.env` for local dev, or set these in your host dashboard (Railway/Render).
# NEVER commit the real .env — only this example belongs in git.

# ---- Razorpay (payments) ----
# From Razorpay Dashboard. Use rzp_live_* keys in production, rzp_test_* for testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Settings > Webhooks. Used to HMAC-verify payment.captured events.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Public site URL (used in WhatsApp links, sitemap, robots.txt) ----
PUBLIC_BASE_URL=https://www.axtroshastra.com

# ---- Storage ----
# SQLite path. Mount a persistent volume at this directory in production.
DB_PATH=./data/reports.db

# ---- Admin key (gates /api/stats and /api/make_pass) ----
STATS_KEY=change-me-to-a-long-random-string

# ---- Twilio WhatsApp delivery (optional; no-op until all set) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# ---- OTP login: provider select ----
# Which backend sends/checks login OTPs. Leave BLANK to auto-detect: Message
# Central if MESSAGECENTRAL_CUSTOMER_ID is set, else Twilio Verify if its SID is
# set, else a dev code logged to the console (local only). Set explicitly to pin
# one: messagecentral | twilio | dev
OTP_PROVIDER=

# ---- OTP login (Message Central / Verify Now, SMS) ----
# From the Message Central dashboard (cpaas.messagecentral.com). When customerId
# is set (and OTP_PROVIDER isn't forced elsewhere), login OTPs go over SMS via
# Message Central. Needs an approved DLT template / sender on the account for
# India delivery. HTTP is stdlib urllib — no SDK, no wheelhouse rebuild.
MESSAGECENTRAL_CUSTOMER_ID=
# Auth: EITHER paste a token from the dashboard (valid ~24h) in AUTH_TOKEN, OR
# leave it blank and set PASSWORD (+ EMAIL) so we mint & cache a token per process.
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_EMAIL=
# Numeric dialling code (no '+') and OTP length (4..8). Defaults suit India.
MESSAGECENTRAL_COUNTRY_CODE=91
MESSAGECENTRAL_OTP_LENGTH=6
# MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com   # override if needed

# ---- OTP login (Twilio Verify) ----
# Create a Verify Service in the Twilio console (Verify > Services) and paste its
# SID here (starts with VA...). When set, login OTPs are sent + checked by Twilio
# Verify, which owns the message templates (the launch-today path for India).
# When UNSET, login falls back to a dev code logged to the console (local only).
TWILIO_VERIFY_SERVICE_SID=
# Delivery channel for the login OTP: whatsapp (default, launchable today) | sms
# (needs DLT template approval first) | call | email.
TWILIO_VERIFY_CHANNEL=whatsapp

# ---- LLM narrative layer (ON in production -> warm LLM prose) ----
# When "1", paid reports get their descriptive PROSE written by an LLM at payment
# time (facts/scores stay engine-computed; prose is cached on the report and
# fact-guarded). Falls back to the deterministic English banks on any error, and
# is a no-op (banks) if ANTHROPIC_API_KEY is unset. Uses stdlib HTTP — no SDK.
NARRATIVE_ENABLED=1                 # 1 = on (set in the host dashboard for prod)
NARRATIVE_PROVIDER=claude          # claude | openai  (swap providers with one var)
NARRATIVE_MODEL=                   # optional override; else claude-sonnet-5 / gpt-4o-mini
NARRATIVE_LANG=english             # english | hi  (per-report meta.lang overrides this)
NARRATIVE_TONE=                    # optional extra voice line for the system prompt
NARRATIVE_TEMPERATURE=0.7
# Leave BLANK: the code sizes tokens per product (marriage needs ~8000 for its 32
# prose slots). Setting a value here overrides that for ALL products — only do so
# deliberately, and never below ~8000 for the marriage report.
NARRATIVE_MAX_TOKENS=
NARRATIVE_TIMEOUT=30
ANTHROPIC_API_KEY=                 # REQUIRED for LLM prose (NARRATIVE_PROVIDER=claude)
OPENAI_API_KEY=                    # for NARRATIVE_PROVIDER=openai

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Local testing only. NEVER set in production. ----
# "1" enables POST /api/_demo_pay/{rid} to bypass real payment.
DEMO_MODE=

# ---- Geocoding (#1) ----
GEOCODER=nominatim                 # nominatim | google | off
GOOGLE_GEOCODING_KEY=
GEOCODER_USER_AGENT=axtroshastra/1.0 (contact: axtroshastra@gmail.com)

# ---- Rate limiting & bot defense (#4) ----
RATE_LIMIT_ENABLED=1               # 1 | 0
CAPTCHA_PROVIDER=                  # ""(off) | hcaptcha | recaptcha
CAPTCHA_SECRET=

# ---- Email delivery (#7) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# ---- Browser-quality PDF (pdfgen.py) ----
# Path to Chrome/Chromium for --print-to-pdf. Unset => common paths probed;
# none found => download button falls back to the print dialog + toaster.
CHROME_BIN=
# Cache dir for pre-generated report PDFs (default ./data/pdfs)
PDF_DIR=
# Approved TEXT WhatsApp template (fallback when the PDF isn't ready) — the
# original report-link template SID. Guarantees delivery if Chrome/PDF fails.
TWILIO_CONTENT_SID_TEXT=
