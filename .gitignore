# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets & runtime data (NEVER commit) ----
.env
.env.*
!.env.example
data/
*.db
*.sqlite
*.sqlite3

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Node / Playwright (E2E) ----
node_modules/
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/blob-report/
playwright/.cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Mount / upload probe artifacts ----
.__*

# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml
# config.yml (app name / env / region) is needed by the CI deploy job — no secrets in it
!.elasticbeanstalk/config.yml
.claude/
